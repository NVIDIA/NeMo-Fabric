{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.nat",
  "adapter_kind": "python",
  "target_types": ["workflow"],
  "runner": {
    "module": "nemo_fabric_adapters.nat.adapter"
  },
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "tool_definition_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "kind": {
        "enum": ["function", "function_group"]
      },
      "ref": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S+$",
        "description": "NeMo Agent Toolkit component type registered by an installed component package."
      },
      "settings": {
        "type": "object",
        "properties": {
          "_type": false
        },
        "additionalProperties": true,
        "description": "NeMo Agent Toolkit component settings; _type is derived from ref."
      }
    },
    "required": ["kind", "ref"],
    "additionalProperties": false
  },
  "requirements": {},
  "config": {
    "accepts": [
      "models",
      "models.base_url",
      "models.temperature",
      "instructions.system",
      "tools.definitions",
      "tools.enabled",
      "tools.blocked",
      "mcp",
      "mcp.tool_filters"
    ],
    "system_instruction_modes": ["append"]
  },
  "capabilities": {
    "cancellation": false,
    "service": false,
    "streaming": true,
    "updates": false
  }
}
