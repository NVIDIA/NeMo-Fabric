{
  "contract_version": "fabric.adapter/v1alpha1",
  "adapter_id": "example.fabric.langgraph",
  "harness": "langgraph",
  "adapter_kind": "python",
  "runner": {
    "module": "nemo_fabric_adapters.langgraph.adapter"
  },
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false
  },
  "workflow_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "entrypoint": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "langgraph_factory",
            "description": "Import and call a Python factory that returns an uncompiled graph."
          },
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$",
            "description": "Python module and factory attribute in module:factory form."
          }
        },
        "required": ["kind", "ref"],
        "additionalProperties": false
      },
      "settings": {
        "type": "object",
        "properties": {
          "llm_name": {
            "type": "string",
            "minLength": 1,
            "description": "Name of the normalized model role passed to the factory as model_config."
          },
          "tool_names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "description": "Factory-declared tool names after applying normalized tools.enabled and tools.blocked."
          },
          "model_config": false,
          "system_instruction": false,
          "mcp_servers": false
        },
        "additionalProperties": true,
        "description": "Application factory settings. The adapter injects reserved normalized-config arguments."
      }
    },
    "required": ["entrypoint"],
    "additionalProperties": false
  },
  "requirements": {},
  "config": {
    "accepts": [
      "models",
      "models.base_url",
      "models.temperature",
      "instructions.system",
      "tools.enabled",
      "tools.blocked",
      "mcp",
      "mcp.tool_filters"
    ]
  },
  "capabilities": {
    "cancellation": false,
    "service": false,
    "streaming": false,
    "updates": false
  }
}
