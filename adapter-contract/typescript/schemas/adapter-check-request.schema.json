{
  "$defs": {
    "CheckLevel": {
      "description": "Agent health level.",
      "oneOf": [
        {
          "const": "live",
          "description": "Observe the native process or session.",
          "type": "string"
        },
        {
          "const": "active",
          "description": "Observe the initialized request interface.",
          "type": "string"
        },
        {
          "const": "ready",
          "description": "Observe required local model, tool, and connection setup.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One adapter health probe using the remaining shared deadline budget.",
  "properties": {
    "level": {
      "$ref": "#/$defs/CheckLevel",
      "description": "One native level to observe."
    },
    "runtime_id": {
      "description": "Exact runtime selected by the core.",
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "timeout_seconds": {
      "description": "Remaining shared deadline budget.",
      "exclusiveMinimum": 0,
      "format": "double",
      "type": "number"
    }
  },
  "required": [
    "runtime_id",
    "level",
    "timeout_seconds"
  ],
  "title": "AdapterCheckRequest",
  "type": "object"
}