{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.openhands",
  "adapter_kind": "python",
  "runner": {
    "module": "nemo_fabric_adapters.openhands.adapter"
  },
  "model_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": {"type": "string", "minLength": 1},
      "model": {"type": "string", "minLength": 1},
      "temperature": {"type": "number", "minimum": 0},
      "top_p": {"type": "number", "minimum": 0, "maximum": 1},
      "max_tokens": {"type": "integer", "minimum": 1},
      "api_key_env": {"type": "string", "minLength": 1},
      "base_url": {"type": "string", "minLength": 1},
      "settings": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "required": ["provider", "model"],
    "additionalProperties": false
  },
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "requirements": {},
  "config": {
    "accepts": [
      "models",
      "models.base_url",
      "models.temperature",
      "models.top_p",
      "models.max_tokens",
      "instructions.system",
      "runtime.max_turns",
      "tools.enabled",
      "tools.blocked",
      "mcp",
      "skills"
    ],
    "system_instruction_modes": ["replace", "append"]
  },
  "capabilities": {
    "service": false,
    "streaming": false,
    "updates": false,
    "cancellation": false
  }
}
