{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.nooa.bench-agent",
  "adapter_kind": "python",
  "runner": {
    "module": "nemo_fabric_adapters.nooa.bench_adapter"
  },
  "model_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "minLength": 1
      },
      "model": {
        "type": "string",
        "minLength": 1
      },
      "temperature": {
        "type": "number"
      },
      "api_key_env": {
        "type": "string",
        "minLength": 1
      },
      "base_url": {
        "type": "string",
        "minLength": 1
      },
      "settings": {
        "type": "object",
        "properties": {
          "client_type": {
            "type": "string",
            "enum": [
              "completion",
              "responses"
            ]
          }
        },
        "additionalProperties": false
      },
      "api": {
        "type": "string",
        "enum": [
          "openai-completions",
          "openai-responses"
        ]
      }
    },
    "required": [
      "provider",
      "model"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "required": [
            "api"
          ],
          "properties": {
            "api": {
              "const": "openai-completions"
            }
          }
        },
        "then": {
          "properties": {
            "provider": {
              "enum": [
                "openai",
                "nvidia"
              ]
            }
          }
        }
      },
      {
        "if": {
          "required": [
            "api"
          ],
          "properties": {
            "api": {
              "const": "openai-responses"
            }
          }
        },
        "then": {
          "properties": {
            "provider": {
              "enum": [
                "openai"
              ]
            }
          }
        }
      }
    ]
  },
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "requirements": {},
  "config": {
    "accepts": [
      "models",
      "models.base_url",
      "models.temperature",
      "instructions.system"
    ]
  },
  "telemetry": {
    "providers": {
      "relay": {
        "outputs": [
          "atif",
          "otel",
          "openinference"
        ]
      }
    }
  },
  "capabilities": {
    "cancellation": false,
    "service": false,
    "streaming": false,
    "updates": false
  },
  "extension_schemas": {
    "model": {
      "type": "object",
      "properties": {
        "api": {
          "type": "string",
          "enum": [
            "openai-completions",
            "openai-responses"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
