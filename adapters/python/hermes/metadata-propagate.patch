+def _request_relay_metadata(body: Any) -> Dict[str, str]:
+    """Extract allowlisted Relay metadata from an OpenAI request body."""
+    if not isinstance(body, dict):
+        return {}
+    metadata = body.get("metadata")
+    if not isinstance(metadata, dict):
+        return {}
+    request_id = metadata.get("nemo_fabric_request_id")
+    if not isinstance(request_id, str) or not request_id:
+        return {}
+    return {"nemo_fabric_request_id": request_id}
+
