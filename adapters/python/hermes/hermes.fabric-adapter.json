{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.hermes",
  "adapter_kind": "python",
  "runner": {
    "module": "nemo_fabric_adapters.hermes.adapter"
  },
  "requirements": {},
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "reasoning_config": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Whether Hermes model reasoning is enabled."
          },
          "effort": {
            "type": "string",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh"
            ],
            "description": "Hermes model reasoning effort."
          }
        },
        "required": [],
        "additionalProperties": false,
        "default": {
          "effort": "none"
        },
        "description": "Hermes model reasoning configuration."
      },
      "plugins_enabled": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "default": [],
        "description": "Hermes plugin identifiers to enable."
      },
      "save_trajectories": {
        "type": "boolean",
        "default": false,
        "description": "Whether Hermes saves its native conversation trajectories as JSONL."
      },
      "max_tokens": {
        "type": "integer",
        "minimum": 1,
        "description": "Maximum number of tokens in each Hermes model response."
      },
      "terminal_timeout": {
        "type": "number",
        "exclusiveMinimum": 0,
        "default": 60,
        "description": "Maximum number of seconds for a Hermes terminal operation."
      },
      "interfaces": {
        "type": "object",
        "properties": {
          "api": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Serve Hermes's OpenAI-compatible API server. A present api interface is on unless this is false."
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "Exact loopback port for the API server. Start fails if it is in use."
              }
            },
            "required": [
              "port"
            ],
            "additionalProperties": false,
            "description": "Hermes's API server, run by a gateway child. After every enabled interface starts, the adapter writes its bearer token to <artifact root>/.fabric/hermes/runtimes/<runtime-id>/interfaces/api.token."
          },
          "dashboard": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Serve Hermes's dashboard and browser chat. A present dashboard is on unless this is false."
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "Exact loopback port for the dashboard. Start fails if it is in use."
              }
            },
            "required": [
              "port"
            ],
            "additionalProperties": false,
            "description": "Hermes's dashboard, which has no sign-in when bound to loopback. It needs a built frontend at HERMES_WEB_DIST."
          }
        },
        "additionalProperties": false,
        "description": "Native interfaces served by the runtime as child processes."
      },
      "startup_timeout_seconds": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 75,
        "default": 60,
        "description": "Time from the start of the runtime for every enabled interface to pass its health check, within NeMo Fabric's 90-second start limit."
      },
      "sdk": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Initialize the embedded SDK agent during startup. Disable for native-only execution; SDK invocation then fails explicitly."
          }
        },
        "additionalProperties": false,
        "description": "Embedded SDK execution, enabled by default. Runtime management remains available when disabled."
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "extension_schemas": {
    "run_error": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "config": {
    "accepts": [
      "models",
      "models.base_url",
      "models.temperature",
      "models.top_p",
      "models.max_tokens",
      "instructions.system",
      "runtime.max_turns",
      "tools.enabled",
      "tools.blocked",
      "mcp",
      "mcp.auth.oauth2",
      "skills"
    ],
    "system_instruction_modes": [
      "replace"
    ]
  },
  "telemetry": {
    "providers": {
      "relay": {
        "outputs": [
          "atif",
          "otel",
          "openinference"
        ]
      }
    }
  },
  "capabilities": {
    "metadata": {
      "health_checks": [
        "live",
        "active",
        "ready"
      ]
    }
  }
}
