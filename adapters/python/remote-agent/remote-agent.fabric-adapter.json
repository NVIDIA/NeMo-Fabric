{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.remote-agent",
  "adapter_kind": "python",
  "runner": {
    "module": "nemo_fabric_adapters.remote_agent.adapter"
  },
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "base_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://",
        "minLength": 1,
        "description": "Remote agent API root, including the /v1 path segment."
      },
      "api_type": {
        "type": "string",
        "enum": [
          "openai-responses",
          "openai-completions",
          "anthropic-messages"
        ],
        "default": "openai-responses",
        "description": "Remote agent API protocol."
      },
      "connect_timeout_seconds": {
        "type": "number",
        "exclusiveMinimum": 0,
        "default": 10,
        "description": "Timeout in seconds for connecting to the remote agent."
      },
      "read_timeout_seconds": {
        "type": "number",
        "exclusiveMinimum": 0,
        "default": 600,
        "description": "Timeout in seconds between response bytes from the remote agent."
      },
      "relay_streaming": {
        "type": "boolean",
        "default": false,
        "description": "Whether the remote service accepts NeMo Fabric request correlation metadata and publishes ATOF to the configured Relay stream sink."
      }
    },
    "required": ["base_url"],
    "additionalProperties": false
  },
  "model_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": {"type": "string", "minLength": 1},
      "model": {"type": "string", "minLength": 1},
      "api_key_env": {"type": "string", "minLength": 1},
      "temperature": {"type": "number"},
      "settings": {
        "type": "object",
        "properties": {
          "max_tokens": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "required": ["provider", "model"],
    "additionalProperties": false
  },
  "requirements": {},
  "config": {
    "accepts": [
      "models",
      "models.temperature",
      "instructions.system"
    ],
    "system_instruction_modes": ["replace"]
  },
  "capabilities": {
    "service": false,
    "streaming": false,
    "updates": false,
    "cancellation": false
  },
  "telemetry": {
    "providers": {
      "relay": {
        "outputs": ["atof"],
        "integration_modes": ["remote_service"]
      }
    }
  }
}
