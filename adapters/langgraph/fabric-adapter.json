{
  "contract_version": "fabric.adapter/v1alpha1",
  "adapter_id": "nvidia.fabric.langgraph",
  "harness": "langgraph",
  "adapter_kind": "python",
  "runner": {
    "module": "nemo_fabric_adapters.langgraph.adapter"
  },
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false
  },
  "workflow_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "entrypoint": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "langgraph_factory",
            "description": "Import and call a Python factory that returns an uncompiled LangGraph graph."
          },
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$",
            "description": "Python module and factory attribute in module:factory form."
          }
        },
        "required": ["kind", "ref"],
        "additionalProperties": false
      },
      "settings": {
        "type": "object",
        "description": "JSON-compatible keyword arguments forwarded to the selected factory."
      }
    },
    "required": ["entrypoint"],
    "additionalProperties": false
  },
  "requirements": {},
  "config": {
    "accepts": []
  }
}
