{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.pi",
  "adapter_kind": "process",
  "runner": {
    "command": "node",
    "script": "dist/cli.js"
  },
  "requirements": {
    "binaries": ["node"]
  },
  "config": {
    "accepts": [
      "models",
      "models.base_url",
      "instructions.system",
      "tools.definitions",
      "tools.enabled",
      "tools.blocked",
      "skills"
    ],
    "system_instruction_modes": ["replace"]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "extensions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "relay_extension_path": {"type": "string", "minLength": 1}
    },
    "additionalProperties": false
  },
  "model_schema": {
    "type": "object",
    "properties": {
      "provider": {"type": "string", "minLength": 1},
      "model": {"type": "string", "minLength": 1},
      "api_key_env": {"type": "string", "minLength": 1},
      "base_url": {"type": ["string", "null"], "format": "uri"}
    },
    "required": ["provider", "model", "api_key_env"],
    "additionalProperties": false
  },
  "tool_definition_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "kind": {"const": "module"},
      "ref": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^#]+(?:#[A-Za-z_$][A-Za-z0-9_$]*)?$"
      },
      "settings": {"type": "object"}
    },
    "required": ["kind", "ref"],
    "additionalProperties": false
  },
  "telemetry": {
    "providers": {
      "relay": {
        "outputs": ["atif", "otel", "openinference"]
      }
    }
  },
  "capabilities": {
    "streaming": false,
    "cancellation": false,
    "updates": false,
    "service": false
  }
}
