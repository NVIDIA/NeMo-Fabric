{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.droid",
  "adapter_kind": "process",
  "runner": {
    "command": "node",
    "script": "dist/cli.js"
  },
  "requirements": {
    "binaries": ["node", "droid"]
  },
  "config": {
    "accepts": [
      "models",
      "instructions.system",
      "tools.enabled",
      "tools.blocked",
      "mcp",
      "skills"
    ],
    "system_instruction_modes": ["replace", "append"]
  },
  "settings_schema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "model_schema": {
    "type": "object",
    "properties": {
      "provider": {"const": "factory"},
      "model": {"type": "string", "minLength": 1},
      "api_key_env": {"type": "string", "minLength": 1}
    },
    "required": ["provider", "model", "api_key_env"],
    "additionalProperties": false
  },
  "extension_schemas": {
    "run_result": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "finish_reason": {
          "type": "string",
          "enum": ["success", "interrupted", "error_during_execution", "error_structured_output"]
        },
        "duration_ms": {"type": "integer", "minimum": 0},
        "turn_count": {"type": "integer", "minimum": 0}
      },
      "required": ["session_id", "finish_reason", "duration_ms", "turn_count"],
      "additionalProperties": false
    },
    "usage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "cache_read_tokens": {"type": "integer", "minimum": 0},
        "cache_write_tokens": {"type": "integer", "minimum": 0},
        "thinking_tokens": {"type": "integer", "minimum": 0},
        "factory_credits": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "capabilities": {
    "streaming": false,
    "cancellation": false,
    "updates": false,
    "service": false
  }
}
