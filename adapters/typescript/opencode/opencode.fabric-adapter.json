{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.opencode",
  "adapter_kind": "process",
  "runner": {
    "command": "bun",
    "script": "dist/cli.js"
  },
  "requirements": {
    "binaries": ["bun"]
  },
  "config": {
    "accepts": [
      "models",
      "models.base_url",
      "models.temperature",
      "models.top_p",
      "instructions.system",
      "skills",
      "mcp"
    ],
    "system_instruction_modes": ["replace"]
  },
  "model_schema": {
    "type": "object",
    "properties": {
      "provider": {"type": "string", "minLength": 1},
      "model": {"type": "string", "minLength": 1},
      "api_key_env": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "base_url": {"type": ["string", "null"], "format": "uri", "pattern": "^https?://"},
      "temperature": {"type": "number"},
      "top_p": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "required": ["provider", "model", "api_key_env"],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "anyOf": [
            {"required": ["temperature"]},
            {"required": ["top_p"]}
          ]
        },
        "then": {
          "properties": {
            "base_url": {"type": "string", "format": "uri", "pattern": "^https?://"}
          },
          "required": ["base_url"]
        }
      }
    ]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "insecure_http_model_hosts": {
        "type": "array",
        "items": {"type": "string", "maxLength": 253, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?$"},
        "uniqueItems": true,
        "description": "Explicitly trusted HTTP model endpoint hostnames, without schemes, ports, paths, or wildcards."
      }
    },
    "additionalProperties": false
  },
  "extension_schemas": {
    "usage": {
      "type": "object",
      "properties": {
        "nvidia.fabric.opencode.usage_evidence.v1": {
          "type": "object",
          "properties": {
            "observed": {
              "type": "object",
              "properties": {
                "input_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                "output_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                "total_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                "cached_input_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                "reasoning_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
              },
              "additionalProperties": false
            },
            "scope_reasons": {
              "type": "array",
              "items": {
                "enum": [
                  "observer_unavailable",
                  "observer_lost",
                  "configuration_changed",
                  "prepare_scope_read_failed",
                  "unsupported_configuration",
                  "root_execution_unconfirmed",
                  "title_completion_unconfirmed",
                  "final_scope_read_failed",
                  "child_ancestry_unverified",
                  "child_ownership_changed",
                  "manual_session_change",
                  "tool_result_unavailable",
                  "background_shell",
                  "background_subagent",
                  "unsupported_protocol",
                  "auxiliary_generation",
                  "unsupported_request_kind",
                  "prompt_failed",
                  "unfinished_work"
                ]
              },
              "uniqueItems": true,
              "description": "Bounded reasons invocation ownership or completion could not be proved; contains no native messages, commands, or credentials."
            },
            "gaps": {
              "type": "array",
              "items": {"enum": ["scope_unverified", "missing_usage", "unfinished_work"]},
              "uniqueItems": true
            }
          },
          "required": ["observed", "gaps"],
          "additionalProperties": false
        }
      },
      "required": ["nvidia.fabric.opencode.usage_evidence.v1"],
      "additionalProperties": false
    }
  },
  "capabilities": {
    "metadata": {"health_checks": ["live", "active", "ready"]},
    "streaming": false,
    "cancellation": false,
    "updates": false,
    "service": false
  }
}
