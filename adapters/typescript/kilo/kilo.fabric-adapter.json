{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.kilo",
  "adapter_kind": "process",
  "runner": {"command": "node", "script": "dist/cli.js"},
  "config": {
    "accepts": [
      "models",
      "models.base_url",
      "models.temperature",
      "models.top_p",
      "instructions.system",
      "runtime.max_turns",
      "tools.enabled",
      "tools.blocked",
      "skills",
      "mcp"
    ],
    "system_instruction_modes": ["replace"]
  },
  "model_schema": {
    "type": "object",
    "properties": {
      "provider": {"type": "string", "minLength": 1},
      "model": {"type": "string", "minLength": 1},
      "api_key_env": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "base_url": {"type": ["string", "null"], "format": "uri", "pattern": "^https?://"},
      "temperature": {"type": "number"},
      "top_p": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "required": ["provider", "model", "api_key_env"],
    "additionalProperties": false
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "allow_insecure_http_model_endpoint": {"type": "boolean"},
      "insecure_http_model_hosts": {
        "type": "array",
        "items": {"type": "string", "maxLength": 253, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?$"},
        "uniqueItems": true,
        "description": "Explicitly trusted HTTP model endpoint hostnames, without schemes, ports, paths, or wildcards."
      }
    },
    "additionalProperties": false
  },
  "extension_schemas": {
    "usage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "nvidia.fabric.kilo.usage_evidence.v1": {
          "type": "object",
          "properties": {
            "observed": {
              "type": "object",
              "properties": {
                "input_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                "output_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                "total_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                "cached_input_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                "cache_write_input_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                "reasoning_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
              },
              "additionalProperties": false
            },
            "gaps": {
              "type": "array",
              "items": {"type": "string", "enum": ["missing_usage", "scope_unverified", "unfinished_work"]},
              "uniqueItems": true
            }
          },
          "required": ["observed", "gaps"],
          "additionalProperties": false
        },
        "nemo_fabric.detailed_token_usage.v1": {
          "type": "object",
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "output_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "cached_input_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "cache_write_input_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "reasoning_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "input_tokens_include_cache": {"const": true},
            "output_tokens_include_reasoning": {"const": true}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "capabilities": {
    "metadata": {"health_checks": ["live", "active", "ready"]},"streaming": false, "cancellation": false, "updates": false, "service": false}
}
