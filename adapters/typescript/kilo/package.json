{
  "name": "nemo-fabric-adapters-kilo",
  "version": "0.4.0",
  "description": "Kilo Code SDK harness adapter for NVIDIA NeMo Fabric.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./descriptor": "./kilo.fabric-adapter.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "nemo-fabric-adapters-kilo": "dist/cli.js"
  },
  "files": ["dist", "kilo.fabric-adapter.json", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "pack:check": "npm run build && node ../scripts/check-package.mjs",
    "prepack": "npm run build",
    "test": "npm run clean && npm run build && node --test test/*.test.mjs"
  },
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org"},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NVIDIA/NeMo-Fabric.git",
    "directory": "adapters/typescript/kilo"
  },
  "bugs": {"url": "https://github.com/NVIDIA/NeMo-Fabric/issues"},
  "homepage": "https://github.com/NVIDIA/NeMo-Fabric/tree/main/adapters/typescript/kilo#readme",
  "engines": {"node": ">=22.19.0"},
  "dependencies": {
    "nemo-fabric-adapter-contract": "0.4.0",
    "nemo-fabric-adapters-common": "0.4.0"
  },
  "peerDependencies": {
    "@kilocode/cli": "7.7.12",
    "@kilocode/sdk": "7.7.12"
  },
  "peerDependenciesMeta": {
    "@kilocode/cli": {"optional": true},
    "@kilocode/sdk": {"optional": true}
  },
  "devDependencies": {
    "@kilocode/sdk": "7.7.12",
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}
