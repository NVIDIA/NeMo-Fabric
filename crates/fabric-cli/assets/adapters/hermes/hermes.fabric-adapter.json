{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.hermes",
  "adapter_kind": "python",
  "runner": {
    "module": "nemo_fabric_adapters.hermes.adapter"
  },
  "requirements": {},
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "reasoning_config": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Whether Hermes model reasoning is enabled."
          },
          "effort": {
            "type": "string",
            "enum": ["none", "minimal", "low", "medium", "high", "xhigh"],
            "description": "Hermes model reasoning effort."
          }
        },
        "required": [],
        "additionalProperties": false,
        "default": {
          "effort": "none"
        },
        "description": "Hermes model reasoning configuration."
      },
      "plugins_enabled": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "default": [],
        "description": "Hermes plugin identifiers to enable."
      },
      "save_trajectories": {
        "type": "boolean",
        "default": false,
        "description": "Whether Hermes saves its native conversation trajectories as JSONL."
      },
      "max_tokens": {
        "type": "integer",
        "minimum": 1,
        "default": 512,
        "description": "Maximum number of tokens in each Hermes model response."
      },
      "terminal_timeout": {
        "type": "number",
        "exclusiveMinimum": 0,
        "default": 60,
        "description": "Maximum number of seconds for a Hermes terminal operation."
      },
      "mode": {
        "type": "string",
        "enum": ["sdk", "api_server"],
        "default": "sdk",
        "description": "Run Hermes in process through its SDK, or as its native API server. api_server mode can also serve the Hermes dashboard and browser TUI."
      },
      "state_dir": {
        "type": "string",
        "minLength": 1,
        "description": "api_server mode only. Directory that retains Hermes configuration, state, the interface token, and api.log across runtimes; relative paths resolve from the NeMo Fabric base directory. When omitted, native state is scoped to the runtime."
      },
      "interfaces": {
        "type": "object",
        "properties": {
          "api": {
            "type": "object",
            "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}},
            "additionalProperties": false,
            "description": "Loopback port of the Hermes API server; defaults to 8642."
          },
          "dashboard": {
            "type": "object",
            "properties": {
              "enabled": {"type": "boolean", "default": true},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "internalPort": {"type": "integer", "minimum": 1, "maximum": 65535},
              "tui": {
                "type": "object",
                "properties": {"enabled": {"type": "boolean"}},
                "required": ["enabled"],
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "description": "Serve the Hermes dashboard on the loopback port (default 18789), forwarded to Hermes on internalPort (default 19119). Omit to disable it."
          }
        },
        "additionalProperties": false,
        "description": "api_server mode only. Native Hermes interfaces bound to loopback and authenticated with the retained interface token."
      },
      "native_config": {
        "type": "object",
        "properties": {
          "web": {"type": "object"},
          "approvals": {"type": "object"},
          "plugins": {"type": "object"},
          "display": {"type": "object"}
        },
        "additionalProperties": false,
        "description": "Hermes config.yaml sections that NeMo Fabric does not derive from FabricConfig. Sections that NeMo Fabric owns are rejected."
      }
    },
    "required": [],
    "if": {"properties": {"mode": {"const": "api_server"}}, "required": ["mode"]},
    "else": {"properties": {"interfaces": false, "state_dir": false}},
    "additionalProperties": false
  },
  "extension_schemas": {
    "run_error": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "provider": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "config": {
    "accepts": [
      "models",
      "models.base_url",
      "models.api",
      "models.temperature",
      "models.top_p",
      "models.max_tokens",
      "instructions.system",
      "runtime.max_turns",
      "tools.enabled",
      "tools.blocked",
      "mcp",
      "mcp.auth.oauth2",
      "skills"
    ],
    "system_instruction_modes": ["replace"]
  },
  "telemetry": {
    "providers": {
      "relay": {
        "outputs": [
          "atif",
          "otel",
          "openinference"
        ]
      }
    }
  }
}
