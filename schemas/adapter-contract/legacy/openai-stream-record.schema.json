      "properties": {
        "invocation_id": {
          "description": "Invocation id for stream correlation.",
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "request_id": {
          "description": "Request id for stream correlation.",
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "runtime_id": {
          "description": "Runtime id for stream correlation.",
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "sequence": {
          "description": "Monotonic zero-based record sequence.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "const": "end",
          "type": "string"
        }
      },
      "required": [
        "type",
        "sequence",
        "runtime_id",
        "invocation_id",
        "request_id"
      ],
      "type": "object"
    }
  ],
  "title": "OpenAiStreamRecord"
}