{
  "$defs": {
    "AdapterConfigField": {
      "description": "Adapter-translated normalized NVIDIA NeMo Fabric configuration fields.",
      "oneOf": [
        {
          "const": "models",
          "description": "Normalized model selection and credentials.",
          "type": "string"
        },
        {
          "const": "models.base_url",
          "description": "Custom model endpoint.",
          "type": "string"
        },
        {
          "const": "models.temperature",
          "description": "Model temperature.",
          "type": "string"
        },
        {
          "const": "models.top_p",
          "description": "Model nucleus sampling probability.",
          "type": "string"
        },
        {
          "const": "models.max_tokens",
          "description": "Maximum model response tokens.",
          "type": "string"
        },
        {
          "const": "instructions.system",
          "description": "Portable system instructions.",
          "type": "string"
        },
        {
          "const": "runtime.max_turns",
          "description": "Per-invocation harness turn limit.",
          "type": "string"
        },
        {
          "const": "runtime.keep_state",
          "description": "Agent-named state folder kept across runtimes.",
          "type": "string"
        },
        {
          "const": "tools.enabled",
          "description": "Adapter-native tool names to expose.",
          "type": "string"
        },
        {
          "const": "tools.definitions",
          "description": "Named normalized tool and tool-group definitions.",
          "type": "string"
        },
        {
          "const": "tools.blocked",
          "description": "Adapter-native tool names to block.",
          "type": "string"
        },
        {
          "const": "mcp",
          "description": "Harness-native MCP servers.",
          "type": "string"
        },
        {
          "const": "mcp.auth.oauth2",
          "description": "OAuth 2.0 authentication for MCP servers.",
          "type": "string"
        },
        {
          "const": "mcp.auth.service_account",
          "description": "OAuth 2.0 service-account authentication for MCP servers.",
          "type": "string"
        },
        {
          "const": "mcp.tool_filters",
          "description": "Per-server MCP tool allowlists and blocklists.",
          "type": "string"
        },
        {
          "const": "skills",
          "description": "Harness-native skills.",
          "type": "string"
        }
      ]
    },
    "AdapterConfigSupport": {
      "additionalProperties": true,
      "description": "Adapter config support.",
      "properties": {
        "accepts": {
          "description": "Normalized NVIDIA NeMo Fabric config areas or policy paths accepted by this adapter.",
          "items": {
            "$ref": "#/$defs/AdapterConfigField"
          },
          "type": "array"
        },
        "generates": {
          "description": "Harness-native files generated by this adapter.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "system_instruction_modes": {
          "description": "Exact system-instruction modes supported by this adapter.\n\nAn omitted value preserves compatibility with descriptors that predate\nmode discovery and means `replace` when `instructions.system` is accepted.",
          "items": {
            "$ref": "#/$defs/InstructionMode"
          },
          "minItems": 1,
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "AdapterKind": {
      "description": "Adapter implementation kind.",
      "oneOf": [
        {
          "const": "process",
          "description": "Launch and supervise a persistent adapter process.",
          "type": "string"
        },
        {
          "const": "http",
          "description": "Connect to a service or HTTP-backed harness.",
          "type": "string"
        },
        {
          "const": "python",
          "description": "Launch and supervise a persistent Python adapter host.",
          "type": "string"
        },
        {
          "const": "native_plugin",
          "description": "Delegate to a harness-native plugin package.",
          "type": "string"
        }
      ]
    },
    "AdapterRequirements": {
      "additionalProperties": true,
      "description": "Adapter runtime requirements.",
      "properties": {
        "binaries": {
          "description": "Required binaries.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "env": {
          "description": "Required environment variables.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "files": {
          "description": "Required files.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "plugin_hooks": {
          "description": "Required harness plugin hooks.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "services": {
          "description": "Required services.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "AdapterSkillsSupport": {
      "additionalProperties": true,
      "dependentRequired": {
        "duplicates": [
          "directory_loading"
        ]
      },
      "description": "Structured skill capabilities implemented by an adapter.\n\nEach sub-block is optional; an omitted block means the adapter does not\nimplement that capability. `duplicates` requires `directory_loading`. The\nadapter must also accept the `skills` config field in `config.accepts`.",
      "properties": {
        "bundled": {
          "anyOf": [
            {
              "$ref": "#/$defs/BundledSkillsSupport"
            },
            {
              "type": "null"
            }
          ],
          "description": "Bundled-skill selection through `skills.bundled`."
        },
        "directory_loading": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillDirectoryLoadingSupport"
            },
            {
              "type": "null"
            }
          ],
          "description": "Structured `skills.directories` loading."
        },
        "duplicates": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillDuplicatesSupport"
            },
            {
              "type": "null"
            }
          ],
          "description": "Duplicate-name policies for `skills.duplicates`."
        }
      },
      "type": "object"
    },
    "AdapterTargetType": {
      "description": "Adapter target categories understood by this Adapter Contract version.",
      "oneOf": [
        {
          "const": "workflow",
          "description": "A separately registered custom-agent or workflow target.",
          "type": "string"
        }
      ]
    },
    "AdapterTelemetryProviderSupport": {
      "additionalProperties": true,
      "description": "Telemetry capabilities for one adapter-supported provider.",
      "properties": {
        "integration_modes": {
          "description": "Integration modes implemented by the adapter for this provider.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "outputs": {
          "description": "Telemetry outputs the adapter can produce or forward for this provider.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "AdapterTelemetrySupport": {
      "additionalProperties": true,
      "description": "Adapter telemetry support.",
      "properties": {
        "providers": {
          "additionalProperties": {
            "$ref": "#/$defs/AdapterTelemetryProviderSupport"
          },
          "description": "Provider-specific telemetry capabilities supported by this adapter.",
          "propertyNames": {
            "enum": [
              "relay",
              "native"
            ]
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "BundledSkillsDefault": {
      "description": "What loads when `skills.bundled` is omitted.",
      "oneOf": [
        {
          "const": "enabled",
          "description": "Bundled skills load by default.",
          "type": "string"
        },
        {
          "const": "disabled",
          "description": "Bundled skills do not load by default.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "The harness ships no bundled skills.",
          "type": "string"
        }
      ]
    },
    "BundledSkillsSupport": {
      "additionalProperties": true,
      "description": "Bundled-skill operations implemented by an adapter. Every field is required.",
      "properties": {
        "default": {
          "$ref": "#/$defs/BundledSkillsDefault",
          "description": "What loads when `skills.bundled` is omitted."
        },
        "supports_disable": {
          "description": "Whether `enabled: false` is implemented.",
          "type": "boolean"
        },
        "supports_enable": {
          "description": "Whether `BundledSkills()` (enabled, no lists) is implemented.",
          "type": "boolean"
        },
        "supports_exclude": {
          "description": "Whether `exclude` (including `[]`) is implemented.",
          "type": "boolean"
        },
        "supports_include": {
          "description": "Whether `include` (including `[]`) is implemented.",
          "type": "boolean"
        }
      },
      "required": [
        "default",
        "supports_enable",
        "supports_disable",
        "supports_include",
        "supports_exclude"
      ],
      "type": "object"
    },
    "InstructionMode": {
      "description": "How an instruction value is applied to the selected harness.",
      "oneOf": [
        {
          "const": "replace",
          "description": "Replace the harness default instruction value.",
          "type": "string"
        },
        {
          "const": "append",
          "description": "Preserve the harness default and append this instruction after it.",
          "type": "string"
        }
      ]
    },
    "NestedSkills": {
      "description": "Discovery behavior below a discovered skill folder.",
      "oneOf": [
        {
          "const": "include",
          "description": "Further skills below a discovered skill folder are discovered too.",
          "type": "string"
        },
        {
          "const": "stop_at_skill",
          "description": "Discovery stops at a skill folder.",
          "type": "string"
        }
      ]
    },
    "RuntimeCapabilities": {
      "description": "Lifecycle behavior implemented by a resolved runtime path.",
      "properties": {
        "cancellation": {
          "default": false,
          "description": "Whether an in-flight invocation can be cancelled.",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Additional adapter-specific capability metadata.",
          "type": "object"
        },
        "service": {
          "default": false,
          "description": "Whether the selected runtime supports service lifecycle operations.",
          "type": "boolean"
        },
        "streaming": {
          "default": false,
          "description": "Whether invocations can emit progressive output.",
          "type": "boolean"
        },
        "updates": {
          "default": false,
          "description": "Whether a running runtime can accept config updates.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "SkillDepthLimit": {
      "description": "Depth bound for skill discovery. The supplied folder is depth zero.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "One numeric bound; immediate children are depth one.",
          "properties": {
            "kind": {
              "const": "fixed",
              "type": "string"
            },
            "levels": {
              "description": "Maximum discovery depth, at least one.",
              "format": "uint32",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "levels"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "No explicit depth cap; exclusions and other constraints still apply.",
          "properties": {
            "kind": {
              "const": "no_fixed_limit",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Context-dependent bounds documented and implemented by the adapter.",
          "properties": {
            "kind": {
              "const": "adapter_defined",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "SkillDirectoryKind": {
      "description": "Kind of one structured external-skill entry.",
      "oneOf": [
        {
          "const": "skill",
          "description": "One skill's folder, which contains `SKILL.md`.",
          "type": "string"
        },
        {
          "const": "folder",
          "description": "A folder whose skills the adapter discovers.",
          "type": "string"
        }
      ]
    },
    "SkillDirectoryLoadingSupport": {
      "additionalProperties": true,
      "description": "How an adapter loads `skills.directories` entries. Every field is required.",
      "properties": {
        "discovery": {
          "$ref": "#/$defs/SkillDiscoverySupport",
          "description": "How the adapter discovers skills inside a `folder` entry."
        },
        "parsing": {
          "$ref": "#/$defs/SkillParsingSupport",
          "description": "How the adapter parses each candidate's `SKILL.md`."
        },
        "skill_file": {
          "const": "SKILL.md",
          "description": "File that marks a skill folder. Must be `SKILL.md`.",
          "type": "string"
        },
        "supported_entries": {
          "description": "Entry kinds the adapter implements. Non-empty and unique.",
          "items": {
            "$ref": "#/$defs/SkillDirectoryKind"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "supported_entries",
        "skill_file",
        "discovery",
        "parsing"
      ],
      "type": "object"
    },
    "SkillDiscoverySupport": {
      "additionalProperties": true,
      "description": "How an adapter traverses a `folder` entry.",
      "properties": {
        "depth_limit": {
          "$ref": "#/$defs/SkillDepthLimit",
          "description": "Depth bound for discovery. Required: there is no implicit unlimited default."
        },
        "nested_skills": {
          "$ref": "#/$defs/NestedSkills",
          "description": "Whether discovery continues below a discovered skill folder."
        },
        "traversal": {
          "$ref": "#/$defs/SkillTraversal",
          "description": "Whether only immediate children or the whole tree is searched."
        }
      },
      "required": [
        "traversal",
        "nested_skills",
        "depth_limit"
      ],
      "type": "object"
    },
    "SkillDuplicatePolicy": {
      "description": "How two `skills.directories` entries that provide the same skill name resolve.",
      "oneOf": [
        {
          "const": "reject",
          "description": "Start fails, naming both entries.",
          "type": "string"
        },
        {
          "const": "last_wins",
          "description": "The later entry's skill loads.",
          "type": "string"
        },
        {
          "const": "first_wins",
          "description": "The earlier entry's skill loads.",
          "type": "string"
        }
      ]
    },
    "SkillDuplicatesSupport": {
      "additionalProperties": true,
      "description": "Duplicate-name policies implemented by an adapter.",
      "properties": {
        "name_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillNameSource"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether skill names are compared by front matter or by folder name."
        },
        "native": {
          "description": "Short description of the harness's own handling when `duplicates` is omitted.",
          "minLength": 1,
          "pattern": "\\S",
          "type": [
            "string",
            "null"
          ]
        },
        "supported_policies": {
          "description": "Policies accepted in `skills.duplicates`. Non-empty and unique.",
          "items": {
            "$ref": "#/$defs/SkillDuplicatePolicy"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "supported_policies"
      ],
      "type": "object"
    },
    "SkillFrontmatterErrors": {
      "description": "Handling of front-matter parse errors in a candidate skill.",
      "oneOf": [
        {
          "const": "recover_key_value",
          "description": "Recover simple `key: value` lines.",
          "type": "string"
        },
        {
          "const": "reject",
          "description": "A parser-reported failure rejects that candidate.",
          "type": "string"
        },
        {
          "const": "adapter_defined",
          "description": "Documented and implemented by the adapter.",
          "type": "string"
        }
      ]
    },
    "SkillNameFallback": {
      "description": "Name used when a skill's front matter has no `name`.",
      "oneOf": [
        {
          "const": "directory_name",
          "description": "The skill folder name.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "No fallback.",
          "type": "string"
        }
      ]
    },
    "SkillNameSource": {
      "description": "Source of the name compared for duplicate detection.",
      "oneOf": [
        {
          "const": "frontmatter",
          "description": "The front-matter `name`.",
          "type": "string"
        },
        {
          "const": "directory",
          "description": "The skill folder name.",
          "type": "string"
        }
      ]
    },
    "SkillParsingSupport": {
      "additionalProperties": true,
      "description": "How an adapter parses each candidate skill's `SKILL.md`.",
      "properties": {
        "frontmatter_errors": {
          "$ref": "#/$defs/SkillFrontmatterErrors",
          "description": "How front-matter parse errors are handled."
        },
        "name_fallback": {
          "$ref": "#/$defs/SkillNameFallback",
          "description": "Whether a missing name falls back to the skill folder name."
        },
        "required_frontmatter_fields": {
          "description": "Front-matter fields the loading path requires. May be empty; unique.",
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "required_frontmatter_fields",
        "name_fallback",
        "frontmatter_errors"
      ],
      "type": "object"
    },
    "SkillTraversal": {
      "description": "Folder traversal used for skill discovery.",
      "oneOf": [
        {
          "const": "immediate_children",
          "description": "Search only the folder's immediate children.",
          "type": "string"
        },
        {
          "const": "recursive",
          "description": "Search the folder recursively.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Language-neutral adapter descriptor for a harness integration.",
  "properties": {
    "adapter_id": {
      "description": "Unique id for this adapter implementation.",
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "adapter_kind": {
      "$ref": "#/$defs/AdapterKind",
      "description": "Adapter implementation kind."
    },
    "capabilities": {
      "$ref": "#/$defs/RuntimeCapabilities",
      "default": {
        "cancellation": false,
        "service": false,
        "streaming": false,
        "updates": false
      },
      "description": "Runtime lifecycle operations supported by this adapter."
    },
    "config": {
      "$ref": "#/$defs/AdapterConfigSupport",
      "default": {},
      "description": "NeMo Fabric config areas this adapter consumes or generates."
    },
    "contract_version": {
      "const": "fabric.adapter/v1alpha2",
      "description": "Adapter descriptor contract version.",
      "minLength": 1,
      "type": "string"
    },
    "extension_schemas": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "description": "JSON Schemas for adapter-owned `extensions` at southbound block types.",
      "propertyNames": {
        "enum": [
          "agent_config",
          "harness",
          "model",
          "instructions",
          "instruction",
          "runtime",
          "skills",
          "mcp",
          "mcp_server",
          "tools",
          "tool_definition",
          "workflow",
          "workflow_entrypoint",
          "run_request",
          "run_result",
          "run_error",
          "artifact",
          "usage"
        ]
      },
      "type": "object"
    },
    "model_schema": {
      "additionalProperties": true,
      "description": "JSON Schema applied to every normalized `FabricConfig.models` entry.",
      "type": [
        "object",
        "null"
      ]
    },
    "requirements": {
      "$ref": "#/$defs/AdapterRequirements",
      "default": {},
      "description": "Runtime requirements."
    },
    "runner": {
      "additionalProperties": true,
      "description": "Generic runner defaults consumed by the selected runtime adapter.",
      "type": "object"
    },
    "settings_schema": {
      "additionalProperties": true,
      "description": "JSON Schema for adapter-owned `harness.settings`.",
      "type": [
        "object",
        "null"
      ]
    },
    "skills": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdapterSkillsSupport"
        },
        {
          "type": "null"
        }
      ],
      "description": "Structured skill capabilities. `None` means only `skills.paths` (when\n`config.accepts` includes `skills`)."
    },
    "target_types": {
      "description": "Registered target categories this adapter can execute.",
      "items": {
        "$ref": "#/$defs/AdapterTargetType"
      },
      "type": "array"
    },
    "telemetry": {
      "$ref": "#/$defs/AdapterTelemetrySupport",
      "default": {},
      "description": "Telemetry support declared by this adapter."
    },
    "tool_definition_schema": {
      "additionalProperties": true,
      "description": "JSON Schema applied to every normalized `FabricConfig.tools.definitions` entry.",
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "contract_version",
    "adapter_id",
    "adapter_kind"
  ],
  "title": "AdapterDescriptor",
  "type": "object"
}