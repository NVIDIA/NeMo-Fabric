{
  "$defs": {
    "AdapterFacts": {
      "description": "Adapter facts.",
      "properties": {
        "id": {
          "description": "Adapter ID from the plan, when an adapter was resolved.",
          "type": [
            "string",
            "null"
          ]
        },
        "package_version": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Version of the adapter package, as the adapter reports it."
        }
      },
      "required": [
        "package_version"
      ],
      "type": "object"
    },
    "AdapterKind": {
      "description": "Adapter implementation kind.",
      "oneOf": [
        {
          "const": "process",
          "description": "Launch and supervise a persistent adapter process.",
          "type": "string"
        },
        {
          "const": "http",
          "description": "Connect to a service or HTTP-backed harness.",
          "type": "string"
        },
        {
          "const": "python",
          "description": "Launch and supervise a persistent Python adapter host.",
          "type": "string"
        },
        {
          "const": "native_plugin",
          "description": "Delegate to a harness-native plugin package.",
          "type": "string"
        }
      ]
    },
    "ArtifactManifest": {
      "additionalProperties": false,
      "description": "Manifest of run artifacts.",
      "properties": {
        "artifacts": {
          "description": "Artifact entries.",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "root": {
          "description": "Artifact root directory.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to one artifact.",
      "properties": {
        "kind": {
          "description": "Artifact kind.",
          "type": "string"
        },
        "media_type": {
          "description": "Optional media type.",
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Artifact-specific metadata preserved across the Rust and Python SDK boundary.",
          "type": "object"
        },
        "name": {
          "description": "Logical artifact name.",
          "type": "string"
        },
        "path": {
          "description": "Artifact path.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "path"
      ],
      "type": "object"
    },
    "EnvironmentFacts": {
      "description": "Environment facts.",
      "properties": {
        "provider": {
          "description": "Environment provider, such as `local`.",
          "type": "string"
        }
      },
      "required": [
        "provider"
      ],
      "type": "object"
    },
    "ErrorInfo": {
      "description": "Normalized error metadata.",
      "properties": {
        "code": {
          "description": "Stable error code.",
          "type": "string"
        },
        "message": {
          "description": "Human-readable error message.",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Adapter or runtime metadata useful for diagnostics.",
          "type": "object"
        },
        "retryable": {
          "default": false,
          "description": "Whether NeMo Fabric considers this failure safe for a consumer-level retry.",
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/ErrorStage",
          "description": "NeMo Fabric lifecycle stage where the failure surfaced."
        }
      },
      "required": [
        "stage",
        "code",
        "message"
      ],
      "type": "object"
    },
    "ErrorStage": {
      "description": "NeMo Fabric lifecycle stage associated with an error.",
      "oneOf": [
        {
          "const": "config",
          "description": "Configuration resolution failed.",
          "type": "string"
        },
        {
          "const": "plan",
          "description": "Effective config planning failed.",
          "type": "string"
        },
        {
          "const": "prepare",
          "description": "Environment preparation failed.",
          "type": "string"
        },
        {
          "const": "start",
          "description": "Runtime start/connect failed.",
          "type": "string"
        },
        {
          "const": "invoke",
          "description": "Runtime invocation failed.",
          "type": "string"
        },
        {
          "const": "stop",
          "description": "Runtime stop/detach failed.",
          "type": "string"
        },
        {
          "const": "release",
          "description": "Environment release failed.",
          "type": "string"
        },
        {
          "const": "artifact",
          "description": "Artifact collection or writing failed.",
          "type": "string"
        }
      ]
    },
    "FabricEvent": {
      "description": "NeMo Fabric lifecycle or progress event.",
      "properties": {
        "event_id": {
          "description": "Event id.",
          "type": "string"
        },
        "kind": {
          "description": "Event kind.",
          "type": "string"
        },
        "message": {
          "description": "Event message.",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Event metadata.",
          "type": "object"
        },
        "timestamp_millis": {
          "description": "Unix timestamp in milliseconds.",
          "format": "uint128",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "timestamp_millis",
        "kind",
        "message"
      ],
      "type": "object"
    },
    "FabricFacts": {
      "description": "NeMo Fabric core facts.",
      "properties": {
        "core_version": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Version of the core that ran the adapter."
        },
        "host_core_version": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Version of the host core that relayed the result from a task core\nin another environment. `not_applicable` for a local run."
        }
      },
      "required": [
        "core_version",
        "host_core_version"
      ],
      "type": "object"
    },
    "FactSource": {
      "description": "How NeMo Fabric learned a fact.",
      "oneOf": [
        {
          "const": "observed",
          "description": "NeMo Fabric core saw it itself.",
          "type": "string"
        },
        {
          "const": "reported",
          "description": "The adapter, the harness, an MCP server or a remote service said so.",
          "type": "string"
        },
        {
          "const": "configured",
          "description": "It comes from the resolved run plan.",
          "type": "string"
        }
      ]
    },
    "FactState": {
      "description": "Why a fact has no value. A collector picks the first state that matches,\nin declaration order.",
      "oneOf": [
        {
          "const": "not_applicable",
          "description": "The fact cannot exist for this run.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "The adapter or environment provider has no source for the fact.",
          "type": "string"
        },
        {
          "const": "collection_failed",
          "description": "A source exists, but it failed, timed out, returned an invalid report\nor never returned.",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "NeMo Fabric holds no value and no evidence for the other states.",
          "type": "string"
        }
      ]
    },
    "Fact_for_Array_of_string": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnownFact_for_Array_of_string",
          "description": "The fact has a value."
        },
        {
          "$ref": "#/$defs/MissingFact",
          "description": "The fact has no value."
        }
      ],
      "description": "One fact: a `value`, or a `state` with a `reason`, never both."
    },
    "Fact_for_boolean": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnownFact_for_boolean",
          "description": "The fact has a value."
        },
        {
          "$ref": "#/$defs/MissingFact",
          "description": "The fact has no value."
        }
      ],
      "description": "One fact: a `value`, or a `state` with a `reason`, never both."
    },
    "Fact_for_string": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnownFact_for_string",
          "description": "The fact has a value."
        },
        {
          "$ref": "#/$defs/MissingFact",
          "description": "The fact has no value."
        }
      ],
      "description": "One fact: a `value`, or a `state` with a `reason`, never both."
    },
    "HarnessFacts": {
      "description": "Harness facts.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Name of the harness program that ran, as the adapter reports it.\nCore never derives it from the adapter ID."
        },
        "version": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Version of the harness program that ran, as the adapter reports it."
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "KnownFact_for_Array_of_string": {
      "description": "A fact with a value.",
      "not": {
        "anyOf": [
          {
            "required": [
              "state"
            ]
          },
          {
            "required": [
              "reason"
            ]
          }
        ]
      },
      "properties": {
        "collected_by": {
          "description": "Component that collected the fact, such as `host_core`, `task_core`\nor `adapter`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "method": {
          "description": "How the collector got the fact, such as `crate_version`,\n`resolved_plan` or `adapter_report`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/FactSource",
          "description": "How NeMo Fabric learned the fact."
        },
        "value": {
          "description": "The fact itself: a string, a boolean or a list of strings.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "value",
        "source",
        "collected_by",
        "method"
      ],
      "type": "object"
    },
    "KnownFact_for_boolean": {
      "description": "A fact with a value.",
      "not": {
        "anyOf": [
          {
            "required": [
              "state"
            ]
          },
          {
            "required": [
              "reason"
            ]
          }
        ]
      },
      "properties": {
        "collected_by": {
          "description": "Component that collected the fact, such as `host_core`, `task_core`\nor `adapter`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "method": {
          "description": "How the collector got the fact, such as `crate_version`,\n`resolved_plan` or `adapter_report`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/FactSource",
          "description": "How NeMo Fabric learned the fact."
        },
        "value": {
          "description": "The fact itself: a string, a boolean or a list of strings.",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "source",
        "collected_by",
        "method"
      ],
      "type": "object"
    },
    "KnownFact_for_string": {
      "description": "A fact with a value.",
      "not": {
        "anyOf": [
          {
            "required": [
              "state"
            ]
          },
          {
            "required": [
              "reason"
            ]
          }
        ]
      },
      "properties": {
        "collected_by": {
          "description": "Component that collected the fact, such as `host_core`, `task_core`\nor `adapter`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "method": {
          "description": "How the collector got the fact, such as `crate_version`,\n`resolved_plan` or `adapter_report`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/FactSource",
          "description": "How NeMo Fabric learned the fact."
        },
        "value": {
          "description": "The fact itself: a string, a boolean or a list of strings.",
          "type": "string"
        }
      },
      "required": [
        "value",
        "source",
        "collected_by",
        "method"
      ],
      "type": "object"
    },
    "McpFacts": {
      "description": "MCP facts.",
      "properties": {
        "servers": {
          "additionalProperties": {
            "$ref": "#/$defs/McpServerFacts"
          },
          "description": "Servers keyed by name. Empty when the plan configures no MCP server\nand the harness reports none.",
          "type": "object"
        }
      },
      "required": [
        "servers"
      ],
      "type": "object"
    },
    "McpRuntimeFacts": {
      "description": "What the harness learned about one MCP server when it connected.",
      "properties": {
        "connected": {
          "$ref": "#/$defs/Fact_for_boolean",
          "description": "Whether the harness connected to the server."
        },
        "protocol_version": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "MCP protocol version negotiated with the server."
        },
        "server_name": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Name the server reports for itself."
        },
        "server_version": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Version the server reports for itself."
        },
        "tool_names": {
          "$ref": "#/$defs/Fact_for_Array_of_string",
          "description": "Raw tool names the server lists, each bounded by the string length\nrule."
        }
      },
      "required": [
        "connected",
        "protocol_version",
        "server_name",
        "server_version",
        "tool_names"
      ],
      "type": "object"
    },
    "McpServerFacts": {
      "description": "Facts about one MCP server.\n\nAn entry with origin `harness` is a server the harness reports and the\nplan does not configure. It has the same shape: its `endpoint` reads\n`not_applicable` with reason `not_configured`, its `transport` may be\nabsent, and runtime facts the adapter did not collect read\n`unavailable` with reason `not_collected`.",
      "if": {
        "properties": {
          "origin": {
            "const": "plan"
          }
        }
      },
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Configured endpoint without secrets: the lowercase scheme and host\nand the port for a network server, or the executable's file name for\na `stdio` server."
        },
        "origin": {
          "description": "Where the entry comes from: `plan` for a server the plan configures,\n`harness` for one only the harness reports.",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/McpRuntimeFacts",
          "description": "What the harness learned when it connected, as the adapter reports it."
        },
        "transport": {
          "description": "Transport, such as `stdio` or `streamable-http`. Always present for\na `plan` entry.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "origin",
        "endpoint",
        "runtime"
      ],
      "then": {
        "properties": {
          "transport": {
            "type": "string"
          }
        },
        "required": [
          "transport"
        ]
      },
      "type": "object"
    },
    "MissingFact": {
      "description": "A fact without a value.",
      "not": {
        "required": [
          "value"
        ]
      },
      "properties": {
        "collected_by": {
          "description": "Component that collected the fact, such as `host_core`, `task_core`\nor `adapter`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "method": {
          "description": "How the collector got the fact, such as `crate_version`,\n`resolved_plan` or `adapter_report`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "reason": {
          "description": "Short code that explains the state, such as `key_not_declared`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/FactSource",
          "description": "How NeMo Fabric learned the fact."
        },
        "state": {
          "$ref": "#/$defs/FactState",
          "description": "Why the fact has no value."
        }
      },
      "required": [
        "state",
        "reason",
        "source",
        "collected_by",
        "method"
      ],
      "type": "object"
    },
    "ModelFacts": {
      "description": "Facts about one model role.",
      "properties": {
        "provider": {
          "description": "Provider from the plan.",
          "type": "string"
        },
        "requested": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Model the plan requested."
        },
        "served": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Model that served, as the harness or provider reports it."
        }
      },
      "required": [
        "provider",
        "requested",
        "served"
      ],
      "type": "object"
    },
    "RunStatus": {
      "description": "Runtime completion status.",
      "oneOf": [
        {
          "const": "succeeded",
          "description": "The harness completed successfully.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "The harness completed with a non-zero status.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "The invocation or runtime was cancelled.",
          "type": "string"
        }
      ]
    },
    "RunUsage": {
      "additionalProperties": false,
      "description": "Normalized invocation usage exposed to NeMo Fabric consumers.",
      "properties": {
        "cached_input_tokens": {
          "description": "Cached input tokens consumed by the invocation, when reported.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cost_usd": {
          "description": "Invocation cost in US dollars when reported by the provider.",
          "format": "double",
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "input_tokens": {
          "description": "Input tokens consumed by the invocation.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "input_tokens_include_cache": {
          "description": "Whether input_tokens already includes cached_input_tokens; absent means unknown.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Adapter-owned usage metadata.",
          "type": "object"
        },
        "output_tokens": {
          "description": "Output tokens produced by the invocation.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "total_tokens": {
          "description": "Total tokens reported by the provider.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TelemetryRef": {
      "description": "Reference to telemetry emitted by Relay or another configured telemetry path.",
      "properties": {
        "kind": {
          "description": "Reference category in the public SDK representation.",
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Telemetry metadata.",
          "type": "object"
        },
        "provider": {
          "description": "Provider in the public SDK reference representation.",
          "type": [
            "string",
            "null"
          ]
        },
        "relay_enabled": {
          "default": false,
          "description": "Whether Relay was enabled for this run; retained for native compatibility.",
          "type": "boolean"
        },
        "trace_id": {
          "description": "Provider trace identity.",
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "description": "Location of the persisted telemetry.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "WhatRan": {
      "description": "What executed for one invocation.\n\nDecoding a `WhatRan` directly checks the shape of every section and\nfact. `RunResult` also checks the schema name and version, and that\nevery `plan` MCP entry names its transport.",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterFacts",
          "description": "Adapter that ran."
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentFacts",
          "description": "Environment the runtime ran in."
        },
        "fabric": {
          "$ref": "#/$defs/FabricFacts",
          "description": "NeMo Fabric core that ran the adapter."
        },
        "harness": {
          "$ref": "#/$defs/HarnessFacts",
          "description": "Harness behind the adapter."
        },
        "mcp": {
          "$ref": "#/$defs/McpFacts",
          "description": "MCP server facts."
        },
        "models": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelFacts"
          },
          "description": "Model facts keyed by the role names of the plan's `models` settings.",
          "type": "object"
        },
        "schema": {
          "const": "nemo.fabric.what_ran",
          "description": "Schema name, `nemo.fabric.what_ran`.",
          "type": "string"
        },
        "version": {
          "const": "v1alpha1",
          "description": "Contract version, `v1alpha1`.",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "version",
        "fabric",
        "adapter",
        "harness",
        "models",
        "mcp",
        "environment"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Result from a NeMo Fabric-managed harness invocation.",
  "properties": {
    "adapter_id": {
      "description": "Adapter implementation id when an adapter descriptor was resolved.",
      "type": [
        "string",
        "null"
      ]
    },
    "adapter_kind": {
      "$ref": "#/$defs/AdapterKind",
      "description": "Adapter used for this run."
    },
    "agent_name": {
      "description": "Stable agent name.",
      "type": "string"
    },
    "artifacts": {
      "$ref": "#/$defs/ArtifactManifest",
      "default": {},
      "description": "Artifacts produced or collected by this run."
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Error metadata when applicable."
    },
    "events": {
      "description": "NeMo Fabric lifecycle/progress events emitted during the run.",
      "items": {
        "$ref": "#/$defs/FabricEvent"
      },
      "type": "array"
    },
    "harness": {
      "description": "Stable machine-readable harness identifier used for this run.",
      "type": "string"
    },
    "invocation_id": {
      "description": "Invocation handle id.",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Adapter-specific metadata.",
      "type": "object"
    },
    "output": {
      "default": null,
      "description": "Primary output."
    },
    "request_id": {
      "description": "Request id.",
      "type": "string"
    },
    "runtime_id": {
      "description": "Runtime handle id.",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus",
      "description": "Runtime status."
    },
    "telemetry": {
      "description": "Ordered telemetry references when available.",
      "items": {
        "$ref": "#/$defs/TelemetryRef"
      },
      "type": "array"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunUsage"
        },
        {
          "type": "null"
        }
      ],
      "description": "Normalized invocation usage when reported by the adapter target."
    },
    "what_ran": {
