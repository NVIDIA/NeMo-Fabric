    "WhatRan": {
      "anyOf": [
        {
          "required": [
            "what_ran_truncated"
          ]
        },
        {
          "required": [
            "fabric",
            "adapter",
            "harness",
            "models",
            "mcp",
            "environment"
          ]
        }
      ],
      "description": "What executed for one invocation.\n\nEvery section is present, unless `what_ran_truncated` is present: then\nthe object is a minimal one that the byte budget left with only its\nschema name and version, and every section may be absent.\n\nDecoding a `WhatRan` directly checks the shape of every section and\nfact, and that no section is `null`. `RunResult` also checks the schema\nname and version, that every section is present unless\n`what_ran_truncated` is, and that every `plan` MCP entry names its\ntransport.",
      "properties": {
        "adapter": {
          "$ref": "#/$defs/AdapterFacts",
          "description": "Adapter that ran."
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentFacts",
          "description": "Environment the runtime ran in."
        },
        "fabric": {
          "$ref": "#/$defs/FabricFacts",
          "description": "NeMo Fabric core that ran the adapter."
        },
        "harness": {
          "$ref": "#/$defs/HarnessFacts",
          "description": "Harness behind the adapter."
        },
        "mcp": {
          "$ref": "#/$defs/McpFacts",
          "description": "MCP server facts."
        },
        "models": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelFacts"
          },
          "description": "Model facts keyed by the role names of the plan's `models` settings.\nAt most 16 roles, in sorted key order, each key at most 128\ncharacters.",
          "type": "object"
        },
        "models_truncated": {
          "$ref": "#/$defs/TruncatedEntries",
          "description": "Model roles dropped from `models`. Absent when none was dropped,\nnever `null`."
        },
        "schema": {
          "const": "nemo.fabric.what_ran",
          "description": "Schema name, `nemo.fabric.what_ran`.",
          "type": "string"
        },
        "version": {
          "const": "v1alpha1",
          "description": "Contract version, `v1alpha1`.",
          "type": "string"
        },
        "what_ran_truncated": {
          "$ref": "#/$defs/TruncatedEntries",
          "description": "Present only on a minimal object: every section was dropped to fit\nits containing record's byte budget, with reason `byte_budget` and\na dropped count of 1. The full-result object uses a 128 KiB budget."
        }
      },
      "required": [
        "schema",
        "version"
      ],
      "type": "object"
    }
  },
