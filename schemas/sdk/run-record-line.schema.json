{
  "$defs": {
    "AdapterFacts": {
      "description": "Adapter facts.",
      "properties": {
        "id": {
          "description": "Adapter ID from the plan, when an adapter was resolved.",
          "type": [
            "string",
            "null"
          ]
        },
        "package_version": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Version of the adapter package, as the adapter reports it."
        }
      },
      "required": [
        "package_version"
      ],
      "type": "object"
    },
    "AppliedPricing": {
      "additionalProperties": false,
      "description": "Persisted entry and selected rates, so saved prices remain reproducible.",
      "properties": {
        "catalog_sha256": {
          "description": "Exact catalog containing this entry.",
          "type": "string"
        },
        "model_id": {
          "description": "Entry's model identity, which may match an explicit alias.",
          "type": "string"
        },
        "pricing_as_of": {
          "description": "Date recorded by the catalog author.",
          "type": "string"
        },
        "pricing_source": {
          "description": "Source recorded by the catalog author.",
          "type": "string"
        },
        "provider": {
          "description": "Entry's provider, without rewriting the observed identity.",
          "type": "string"
        },
        "rates": {
          "$ref": "#/$defs/RateSnapshot",
          "description": "One selected rate set; distinct selections are retained in `model_usage::TokenCost.applied_rates`."
        }
      },
      "required": [
        "catalog_sha256",
        "provider",
        "model_id",
        "pricing_as_of",
        "pricing_source",
        "rates"
      ],
      "type": "object"
    },
    "ContextValue": {
      "anyOf": [
        {
          "description": "An allowlisted key's string value, cut to 256 characters.",
          "type": "string"
        },
        {
          "description": "An allowlisted key's integer value.",
          "format": "int64",
          "type": "integer"
        },
        {
          "$ref": "#/$defs/NotRecorded",
          "description": "Any other key or value: the key name only."
        }
      ],
      "description": "A request context value as the start line keeps it."
    },
    "CostAmount": {
      "description": "Complete and observed amounts in integer nano-USD.",
      "properties": {
        "amount_nano_usd": {
          "description": "Complete amount for this invocation/model scope.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "observed_nano_usd": {
          "description": "Valid observed contributions, not a guaranteed bound or invoice.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "EndArtifact": {
      "description": "One result artifact on the end line.",
      "properties": {
        "kind": {
          "description": "Artifact kind.",
          "type": "string"
        },
        "media_type": {
          "description": "Media type.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Logical artifact name.",
          "type": "string"
        },
        "path": {
          "description": "Path relative to the artifact root; absent for a path outside it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "type": "object"
    },
    "EndError": {
      "description": "The end line's error.",
      "properties": {
        "code": {
          "description": "Error code matching `^[a-z0-9_.:-]{1,128}$`, else `unrecognized`.",
          "pattern": "^[a-z0-9_.:-]{1,128}$",
          "type": "string"
        },
        "retryable": {
          "description": "Whether a consumer-level retry is considered safe.",
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/ErrorStage",
          "description": "Lifecycle stage where the failure surfaced."
        }
      },
      "required": [
        "code",
        "stage",
        "retryable"
      ],
      "type": "object"
    },
    "EndLine": {
      "description": "Fields of the end line.",
      "properties": {
        "artifacts": {
          "description": "Result artifacts, with paths relative to the artifact root.",
          "items": {
            "$ref": "#/$defs/EndArtifact"
          },
          "type": "array"
        },
        "elapsed_ms": {
          "description": "Monotonic time from the start line to the end line, in milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Error code, stage and retryable flag, without the message."
        },
        "model_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelUsage"
            },
            {
              "type": "null"
            }
          ],
          "description": "Validated normalized accounting frozen at the invocation boundary."
        },
        "outcome_scope": {
          "const": "invocation",
          "description": "This line observes the invocation, before one-shot runtime shutdown.",
          "type": "string"
        },
        "result": {
          "description": "Expected full-result file next to this record; absence means not saved.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/RunStatus",
          "description": "Final status. A Fabric lifecycle error, such as a host timeout, reads `failed`."
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndUsage"
            },
            {
              "type": "null"
            }
          ],
          "description": "Numeric usage counters, without adapter metadata."
        },
        "what_ran": {
          "anyOf": [
            {
              "$ref": "#/$defs/WhatRan"
            },
            {
              "type": "null"
            }
          ],
          "description": "Bounded execution facts frozen with the finalized invocation result."
        }
      },
      "required": [
        "outcome_scope",
        "status",
        "elapsed_ms"
      ],
      "type": "object"
    },
    "EndUsage": {
      "description": "The end line's usage: the numeric `RunUsage` fields.",
      "properties": {
        "cached_input_tokens": {
          "description": "Cached input tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cost_usd": {
          "description": "Reported cost in US dollars.",
          "format": "double",
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "input_tokens": {
          "description": "Input tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "input_tokens_include_cache": {
          "description": "Whether `input_tokens` includes `cached_input_tokens`; absent means unknown.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "output_tokens": {
          "description": "Output tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "total_tokens": {
          "description": "Total tokens reported by the provider.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "EnvironmentFacts": {
      "description": "Environment facts.",
      "properties": {
        "provider": {
          "description": "Environment provider, such as `local`.",
          "type": "string"
        }
      },
      "required": [
        "provider"
      ],
      "type": "object"
    },
    "ErrorStage": {
      "description": "NeMo Fabric lifecycle stage associated with an error.",
      "oneOf": [
        {
          "const": "config",
          "description": "Configuration resolution failed.",
          "type": "string"
        },
        {
          "const": "plan",
          "description": "Effective config planning failed.",
          "type": "string"
        },
        {
          "const": "prepare",
          "description": "Environment preparation failed.",
          "type": "string"
        },
        {
          "const": "start",
          "description": "Runtime start/connect failed.",
          "type": "string"
        },
        {
          "const": "invoke",
          "description": "Runtime invocation failed.",
          "type": "string"
        },
        {
          "const": "stop",
          "description": "Runtime stop/detach failed.",
          "type": "string"
        },
        {
          "const": "release",
          "description": "Environment release failed.",
          "type": "string"
        },
        {
          "const": "artifact",
          "description": "Artifact collection or writing failed.",
          "type": "string"
        }
      ]
    },
    "FabricFacts": {
      "description": "NeMo Fabric core facts.",
      "properties": {
        "core_version": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Version of the core that ran the adapter."
        },
        "host_core_version": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Version of the host core that relayed the result from a task core\nin another environment. `not_applicable` for a local run."
        }
      },
      "required": [
        "core_version",
        "host_core_version"
      ],
      "type": "object"
    },
    "FactSource": {
      "description": "How NeMo Fabric learned a fact.",
      "oneOf": [
        {
          "const": "observed",
          "description": "NeMo Fabric core saw it itself.",
          "type": "string"
        },
        {
          "const": "reported",
          "description": "The adapter, the harness, an MCP server or a remote service said so.",
          "type": "string"
        },
        {
          "const": "configured",
          "description": "It comes from the resolved run plan.",
          "type": "string"
        }
      ]
    },
    "FactState": {
      "description": "Why a fact has no value. A collector picks the first state that matches,\nin declaration order.",
      "oneOf": [
        {
          "const": "not_applicable",
          "description": "The fact cannot exist for this run.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "The adapter or environment provider has no source for the fact.",
          "type": "string"
        },
        {
          "const": "collection_failed",
          "description": "A source exists, but it failed, timed out, returned an invalid report\nor never returned.",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "NeMo Fabric holds no value and no evidence for the other states.",
          "type": "string"
        }
      ]
    },
    "Fact_for_Array_of_string": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnownFact_for_Array_of_string",
          "description": "The fact has a value."
        },
        {
          "$ref": "#/$defs/MissingFact",
          "description": "The fact has no value."
        }
      ],
      "description": "One fact: a `value`, or a `state` with a `reason`, never both."
    },
    "Fact_for_boolean": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnownFact_for_boolean",
          "description": "The fact has a value."
        },
        {
          "$ref": "#/$defs/MissingFact",
          "description": "The fact has no value."
        }
      ],
      "description": "One fact: a `value`, or a `state` with a `reason`, never both."
    },
    "Fact_for_string": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnownFact_for_string",
          "description": "The fact has a value."
        },
        {
          "$ref": "#/$defs/MissingFact",
          "description": "The fact has no value."
        }
      ],
      "description": "One fact: a `value`, or a `state` with a `reason`, never both."
    },
    "GapReason": {
      "description": "Categories that affect whether a consumer can treat a value as complete.",
      "oneOf": [
        {
          "const": "unfinished_work",
          "description": "Owned work was still running at the return boundary.",
          "type": "string"
        },
        {
          "const": "missing_usage",
          "description": "A completed call did not provide usable usage.",
          "type": "string"
        },
        {
          "const": "scope_unverified",
          "description": "The supported source does not establish coverage of owned work.",
          "type": "string"
        }
      ]
    },
    "HarnessFacts": {
      "description": "Harness facts.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Name of the harness program that ran, as the adapter reports it.\nCore never derives it from the adapter ID."
        },
        "version": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Version of the harness program that ran, as the adapter reports it."
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "KnownFact_for_Array_of_string": {
      "description": "A fact with a value.",
      "not": {
        "anyOf": [
          {
            "required": [
              "state"
            ]
          },
          {
            "required": [
              "reason"
            ]
          }
        ]
      },
      "properties": {
        "collected_by": {
          "description": "Component that collected the fact, such as `host_core`, `task_core`\nor `adapter`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "method": {
          "description": "How the collector got the fact, such as `crate_version`,\n`resolved_plan` or `adapter_report`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/FactSource",
          "description": "How NeMo Fabric learned the fact."
        },
        "value": {
          "description": "The fact itself: a string, a boolean or a list of strings.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "value",
        "source",
        "collected_by",
        "method"
      ],
      "type": "object"
    },
    "KnownFact_for_boolean": {
      "description": "A fact with a value.",
      "not": {
        "anyOf": [
          {
            "required": [
              "state"
            ]
          },
          {
            "required": [
              "reason"
            ]
          }
        ]
      },
      "properties": {
        "collected_by": {
          "description": "Component that collected the fact, such as `host_core`, `task_core`\nor `adapter`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "method": {
          "description": "How the collector got the fact, such as `crate_version`,\n`resolved_plan` or `adapter_report`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/FactSource",
          "description": "How NeMo Fabric learned the fact."
        },
        "value": {
          "description": "The fact itself: a string, a boolean or a list of strings.",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "source",
        "collected_by",
        "method"
      ],
      "type": "object"
    },
    "KnownFact_for_string": {
      "description": "A fact with a value.",
      "not": {
        "anyOf": [
          {
            "required": [
              "state"
            ]
          },
          {
            "required": [
              "reason"
            ]
          }
        ]
      },
      "properties": {
        "collected_by": {
          "description": "Component that collected the fact, such as `host_core`, `task_core`\nor `adapter`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "method": {
          "description": "How the collector got the fact, such as `crate_version`,\n`resolved_plan` or `adapter_report`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/FactSource",
          "description": "How NeMo Fabric learned the fact."
        },
        "value": {
          "description": "The fact itself: a string, a boolean or a list of strings.",
          "type": "string"
        }
      },
      "required": [
        "value",
        "source",
        "collected_by",
        "method"
      ],
      "type": "object"
    },
    "McpFacts": {
      "description": "MCP facts.",
      "properties": {
        "servers": {
          "additionalProperties": {
            "$ref": "#/$defs/McpServerFacts"
          },
          "description": "Servers keyed by name. Empty when the plan configures no MCP server\nand the harness reports none. At most 32 servers, in sorted key\norder, each key at most 128 characters.",
          "type": "object"
        },
        "servers_truncated": {
          "$ref": "#/$defs/TruncatedEntries",
          "description": "Servers dropped from `servers`. Absent when none was dropped, never\n`null`."
        }
      },
      "required": [
        "servers"
      ],
      "type": "object"
    },
    "McpRuntimeFacts": {
      "description": "What the harness learned about one MCP server when it connected.",
      "properties": {
        "connected": {
          "$ref": "#/$defs/Fact_for_boolean",
          "description": "Whether the harness connected to the server."
        },
        "protocol_version": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "MCP protocol version negotiated with the server."
        },
        "server_name": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Name the server reports for itself."
        },
        "server_version": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Version the server reports for itself."
        },
        "tool_names": {
          "$ref": "#/$defs/Fact_for_Array_of_string",
          "description": "Raw tool names the server lists, each bounded by the string length\nrule."
        }
      },
      "required": [
        "connected",
        "protocol_version",
        "server_name",
        "server_version",
        "tool_names"
      ],
      "type": "object"
    },
    "McpServerFacts": {
      "description": "Facts about one MCP server.\n\nAn entry with origin `harness` is a server the harness reports and the\nplan does not configure. It has the same shape: its `endpoint` reads\n`not_applicable` with reason `not_configured`, and runtime facts the\nadapter did not collect read `unavailable` with reason `not_collected`.\nOnly a `plan` entry must name its transport. An entry of any other\norigin may leave it out.",
      "if": {
        "properties": {
          "origin": {
            "const": "plan"
          }
        }
      },
      "properties": {
        "endpoint": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Configured endpoint without secrets: the lowercase scheme and host\nand the port for a network server, or the executable's file name for\na `stdio` server."
        },
        "origin": {
          "description": "Where the entry comes from: `plan` for a server the plan configures,\n`harness` for one only the harness reports.",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/McpRuntimeFacts",
          "description": "What the harness learned when it connected, as the adapter reports it."
        },
        "transport": {
          "description": "Transport, such as `stdio` or `streamable-http`. Required for a\n`plan` entry, and optional for any other origin.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "origin",
        "endpoint",
        "runtime"
      ],
      "then": {
        "properties": {
          "transport": {
            "type": "string"
          }
        },
        "required": [
          "transport"
        ]
      },
      "type": "object"
    },
    "MissingFact": {
      "description": "A fact without a value.",
      "not": {
        "required": [
          "value"
        ]
      },
      "properties": {
        "collected_by": {
          "description": "Component that collected the fact, such as `host_core`, `task_core`\nor `adapter`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "method": {
          "description": "How the collector got the fact, such as `crate_version`,\n`resolved_plan` or `adapter_report`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "reason": {
          "description": "Short code that explains the state, such as `key_not_declared`.",
          "pattern": "^[a-z0-9_.:#+/-]{1,128}$",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/FactSource",
          "description": "How NeMo Fabric learned the fact."
        },
        "state": {
          "$ref": "#/$defs/FactState",
          "description": "Why the fact has no value."
        }
      },
      "required": [
        "state",
        "reason",
        "source",
        "collected_by",
        "method"
      ],
      "type": "object"
    },
    "ModelFacts": {
      "description": "Facts about one model role.",
      "properties": {
        "provider": {
          "description": "Provider from the plan.",
          "type": "string"
        },
        "requested": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Model the plan requested."
        },
        "served": {
          "$ref": "#/$defs/Fact_for_string",
          "description": "Model that served, as the harness or provider reports it."
        }
      },
      "required": [
        "provider",
        "requested",
        "served"
      ],
      "type": "object"
    },
    "ModelName": {
      "description": "One configured model.",
      "properties": {
        "model": {
          "description": "Provider model identifier.",
          "type": "string"
        },
        "provider": {
          "description": "Model provider name.",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "type": "object"
    },
    "ModelUsage": {
      "description": "Normalized accounting frozen at return. Late usage never moves to a later invocation.",
      "properties": {
        "cache_write_input_tokens": {
          "description": "Independently known cache writes.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cached_input_tokens": {
          "description": "Independently known cache reads.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cost": {
          "$ref": "#/$defs/TokenCost",
          "description": "Separately typed provider-reported amounts and catalog estimates."
        },
        "gaps": {
          "description": "Dimension-specific completeness gaps.",
          "items": {
            "$ref": "#/$defs/UsageGap"
          },
          "type": "array"
        },
        "input_tokens": {
          "description": "Cache-inclusive input.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "models": {
          "description": "Literal per-model breakdown, when the source establishes attribution.",
          "items": {
            "$ref": "#/$defs/PerModelUsage"
          },
          "type": "array"
        },
        "models_exhaustive": {
          "description": "Whether all model identities used by owned work are represented.",
          "type": "boolean"
        },
        "observed": {
          "$ref": "#/$defs/TokenCounts",
          "description": "Available deduplicated observations; these are not guaranteed lower bounds."
        },
        "output_tokens": {
          "description": "Reasoning-inclusive output.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "total_tokens": {
          "description": "Input plus output; the independent provider total remains raw evidence.",
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
