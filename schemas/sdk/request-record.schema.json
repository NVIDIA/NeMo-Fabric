{
  "$defs": {
    "RecordVersion": {
      "description": "The record's line format version.",
      "oneOf": [
        {
          "const": "v1alpha1",
          "description": "`v1alpha1`.",
          "type": "string"
        }
      ]
    },
    "RequestSchema": {
      "enum": [
        "nemo.fabric.request_record"
      ],
      "type": "string"
    },
    "RequestStage": {
      "enum": [
        "start",
        "invoke"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A request record does not imply a runtime or invocation was created.",
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "start",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "oneOf": [
        {
          "properties": {
            "invocation_id": {
              "type": "string"
            },
            "result": {
              "type": "string"
            },
            "runtime_id": {
              "type": "string"
            },
            "state": {
              "const": "returned",
              "type": "string"
            }
          },
          "required": [
            "state",
            "runtime_id",
            "invocation_id",
            "result"
          ],
          "type": "object"
        },
        {
          "properties": {
            "stage": {
              "$ref": "#/$defs/RequestStage"
            },
            "state": {
              "const": "no_result",
              "type": "string"
            }
          },
          "required": [
            "state",
            "stage"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "kind": {
          "const": "end",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    }
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "schema": {
      "$ref": "#/$defs/RequestSchema"
    },
    "time": {
      "format": "date-time",
      "type": "string"
    },
    "version": {
      "$ref": "#/$defs/RecordVersion"
    }
  },
  "required": [
    "schema",
    "version",
    "request_id",
    "time"
  ],
  "title": "RequestRecord",
  "type": "object"
}