{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.example.langgraph.email-phishing",
  "harness": "langgraph-email-phishing",
  "adapter_kind": "python",
  "runner": {
    "module": "examples.langgraph_custom_agent.adapter.runtime"
  },
  "requirements": {},
  "config": {
    "input": "agent_config",
    "accepts": [
      "models",
      "models.base_url",
      "models.temperature",
      "instructions.system",
      "mcp",
      "mcp.tool_filters"
    ]
  },
  "telemetry": {
    "providers": {
      "relay": {
        "outputs": ["atif"],
        "integration_modes": ["sdk"]
      }
    }
  },
  "capabilities": {
    "cancellation": false,
    "service": false,
    "streaming": false,
    "updates": false
  }
}
